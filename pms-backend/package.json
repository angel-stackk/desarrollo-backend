{
  "name": "pms-backend",
  "version": "1.0.0",
  "description": "PMS - Sistema de Gestión de Proyectos",
  "main": "dist/src/main.js",
  "scripts": {
    "start": "ts-node src/main.ts",
    "dev": "nodemon src/main.ts",
