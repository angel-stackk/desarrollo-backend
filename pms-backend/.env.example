# Variables de entorno para el despliegue en Docker (EC2).
# Copiar a `.env` (ignorado por Git) y rellenar los valores reales:
#   cp .env.example .env && nano .env
#
# Docker Compose lee este mismo archivo `.env` para interpolar las variables
# y lo pasa al contenedor de la aplicación mediante `env_file`.

# --- Aplicación ---
NODE_ENV=production
PORT=3000
# Número de workers del clúster de Node (ajustar al nº de vCPU de la instancia)
CLUSTER_WORKERS=2
# Secreto JWT (usar una cadena larga y aleatoria)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# --- PostgreSQL (servicio `db`) ---
DB_USERNAME=pms
DB_PASSWORD=cambia-esto
DB_NAME=pms_db
# Sincronización automática del esquema de TypeORM.
# `true` la primera vez (para crear el esquema) o en desarrollo.
# En producción con varios workers (CLUSTER_WORKERS > 1) dejarlo en `false`:
# si no, los workers crean el esquema a la vez y uno falla.
DB_SYNCHRONIZE=true

# --- RabbitMQ (servicio `rabbitmq`) ---
RABBITMQ_USER=pms
RABBITMQ_PASS=cambia-esto

# --- Correo (SMTP) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@pms.local
